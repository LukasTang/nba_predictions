# Data is DVC-tracked: per-directory .gitignore files (written by DVC) keep the
# actual data out of git while allowing the .dvc pointer files to be committed.

# DVC
/.dvc/cache
/.dvc/tmp

# MLflow
/mlruns/
/mlartifacts/

# Reports / outputs
/reports/
metrics.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/
